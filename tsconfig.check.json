{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": false,
    "jsx": "react-jsx",
    "paths": {
      "@macrostrat/*": [
        "./packages/*/src/index.ts",
        "./toolchain/*/src/index.ts"
      ]
    }
  },
  "include": ["packages/*/src", "packages/*/stories", "stories"]
}
